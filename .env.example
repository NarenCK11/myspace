# ---------------------------------------------------------------------------
# MySpace - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_NAME=MySpace
ENVIRONMENT=development           # development | staging | production
DEBUG=false

# --- Database --------------------------------------------------------------
# Local docker-compose value; replace with your managed Postgres URL in prod.
DATABASE_URL=postgresql+psycopg://myspace:myspace@localhost:5432/myspace

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts Google OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Owner account (single user) -------------------------------------------
# Used once by: python -m app.cli create-owner
OWNER_LOGIN_ID=owner
OWNER_PASSWORD=change-this-to-a-long-passphrase
OWNER_DISPLAY_NAME=Owner
OWNER_EMAIL=
OWNER_TIMEZONE=UTC

# --- Cookies ---------------------------------------------------------------
# Local HTTP dev: COOKIE_SECURE=false and COOKIE_SAMESITE=lax
# Production (frontend and API on different domains): true / none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- URLs / CORS -----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Login rate limiting ---------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- Google Calendar (OPTIONAL) --------------------------------------------
# Leave these blank to run without Google Calendar. The portal is fully usable
# without it: the calendar still shows tasks, reminders and activities, and the
# UI hides the integration entirely rather than prompting you to set it up.
#
# To switch it on later, fill in the two values below (Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID), restart the backend, then
# press Connect in Settings > Google Calendar. See README section 5.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
GOOGLE_SYNC_WINDOW_PAST_DAYS=30
GOOGLE_SYNC_WINDOW_FUTURE_DAYS=120

# --- Frontend (frontend/.env.local) ----------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
