# Frontend environment. Copy to .env.local for local dev, or set in Vercel.

# Production: the full origin of your deployed backend, e.g.
#   VITE_API_BASE_URL=https://myspace-api.onrender.com
# Leave EMPTY for local development: the Vite dev server proxies /api instead,
# which keeps the refresh cookie same-origin.
VITE_API_BASE_URL=

# Local only: where the dev server should proxy /api to (default http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
